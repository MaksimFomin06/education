APP_NAME=slotkeeper
APP_ENV=local
APP_PORT=8080
LOG_LEVEL=INFO

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=slotkeeper
POSTGRES_USER=slotkeeper
POSTGRES_PASSWORD=slotkeeper
DATABASE_URL=postgresql+asyncpg://slotkeeper:slotkeeper@postgres:5432/slotkeeper

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change_me_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

ENABLE_CARRIER_INTEGRATION=true
ENABLE_LEGACY_SLOT_ENDPOINT=true

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

CARRIER_API_BASE_URL=http://mock-carrier:8090
CARRIER_API_TIMEOUT_SECONDS=2
CARRIER_API_RETRIES=2
