s = input()
ans = "YES"

pairs = {
    ")": "(",
    "]": "[",
    "}": "{",
}

stack = []

for i in s:
    if i in "([{":
        stack.append(i)
    else:
        if not stack or (stack and stack[-1] != pairs[i]):
            ans = "NO"
            break
    
        stack.pop()

if stack:
    ans = "NO"

print(ans)
