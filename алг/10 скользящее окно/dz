n = int(input())
arr = list(map(int, input().split()))
k = int(input())

curr_count = 0

for i in range(k):
    if arr[i] % 2 == 0:
        curr_count += 1

max_count = curr_count

for ind in range(k, n):
    delet = arr[ind-k]
    dob = arr[ind]

    if delet % 2 == 0:
        curr_count -= 1
    if dob % 2 == 0:
        curr_count += 1

    if curr_count > max_count:
        max_count = curr_count

print(max_count)
