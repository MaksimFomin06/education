n = int(input())
arr = list(map(int, input().split()))
k = int(input())

window_summ = 0

for i in range(k):
    window_summ += arr[i]

ans = window_summ

for right in range(k, n):
    window_summ += arr[right]
    window_summ -= arr[right - k]

    if window_summ > ans:
        ans = window_summ

print(ans)
