n = int(input())
arr = list(map(int, input().split()))
target = int(input())

min_len = n + 1
left = 0
summ = 0

for right in range(n):
    summ += arr[right]

    while summ >= target:
        curr_len = right - left + 1
        min_len = min(curr_len, min_len)

        summ -= arr[left]
        left += 1

if min_len == n + 1:
    print(-1)
else:
    print(min_len)
