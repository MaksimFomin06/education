from collections import deque


n = int(input())
names = deque()

for i in range(n):
    name = input()
    names.append(name)

k = int(input())

if len(names) < k:
    print(*names)
else:
    ans = []
    for i in range(k):
        ans.append(names.popleft())
    
    print(*ans)