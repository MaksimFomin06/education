from collections import deque

n = int(input())
deq = deque()

for i in range(n):
    command = input().split()

    if command[0] == "push":
        num = int(command[1])

        deq.append(num)
    else:
        if deq:
            print(deq.popleft())
        else:
            print("EMPTY")
