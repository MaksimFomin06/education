n = int(input())
nums = list(map(int, input().split()))

slow = 1
fast = 1

for i in range(1, n):
    elem = nums[fast]

    if elem != nums[slow - 1]:
        nums[slow] = elem
        slow += 1
    fast += 1

print(*nums[:slow])
