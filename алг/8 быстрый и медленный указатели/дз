n = int(input())
nums = list(map(int, input().split()))

chet = []
nechet = []

for i in range(n):
    elem = nums[i]
    if elem % 2 == 0:
        chet.append(elem)
    else:
        nechet.append(elem)

ans = chet+nechet
print(*ans)