n = int(input())
nums = list(map(int, input().split()))
target = int(input())

left = 0
right = len(nums) - 1

ans = "NO"

while left < right:
    summ = nums[left] + nums[right]
    if summ == target:
        ans = "YES"
        break
    elif summ < target:
        left += 1
    elif summ > target:
        right -= 1
print(ans)
