Минипроверка:
1) Потому что проходимся по одному разу по каждому массиву
2) I идет по эдементам первого массива, j по элементам второго массива, они сравниваются между собой и увеличиваются в случае успеха
3) Потому что в втором массиве могут остаться элементы
4) сляиние двумя указателями
5) O(n + m)
ДЗ
1)
n = int(input())
a = list(map(int, input().split()))
m = int(input())
b = list(map(int, input().split()))

ans = []

i = 0
j = 0

while i < n and j < m:
    if a[i] <= b[j]:
        ans.append(a[i])
        i += 1
    else:
        ans.append(b[j])
        j += 1

while i < n:
    ans.append(a[i])
    i += 1

while j < m:
    ans.append(b[j])
    j += 1

print(*ans)
2)
n1 = int(input())
arr1 = list(map(int, input().split()))
n2 = int(input())
arr2 = list(map(int, input().split()))

ans = []

i, j = 0, 0

while i < n1 and j < n2:
    if arr1[i] == arr2[j]:
        ans.append(arr1[i])
        i += 1
        j += 1
    elif arr1[i] < arr2[j]:
        i += 1
    else:
        j += 1

print(*ans)
