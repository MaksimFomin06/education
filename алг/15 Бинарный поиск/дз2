# Мне нужно найти самый крайний элемент который не больше target
# Буду использовать бинарный поиск lower_bound
# Время будет O(log n)

n = int(input())
arr = list(map(int, input().split()))
target = int(input())

ans = -1
left = 0
right = n -1

while left <= right:
    mid = (left + right) // 2

    if arr[mid] <= target:
        ans = mid
        left = mid + 1
    else:
        right = mid - 1

print(ans)

