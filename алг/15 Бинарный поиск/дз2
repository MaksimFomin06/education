3) 
# Мне нужно найти количество target в массиве
# Использовать буду алгоритм бинарного поиска 
# Для начала найду upper lower bound затем вычту lower из upper и получу ответ
# Время будет O(log n)

n = int(input())
arr = list(map(int, input().split()))
target = int(input())

left = 0
lower, upper = n, n
right = n - 1

while left <= right:
    mid = (left + right) // 2

    if arr[mid] > target:
        upper = mid
        right = mid - 1    
    else:
        left = mid + 1

left = 0
right = n - 1

while left <= right:
    mid = (left + right) // 2

    if arr[mid] >= target:
        lower = mid
        right = mid - 1
    else:
        left = mid + 1

if lower == n or arr[lower] != target:
    print(0)
else:
    print(upper - lower)

# Важно: Тут не обработан случай когда все элементы массива одинаковые и target равен этим элементам, можно будет добавить проверку if arr[0] == arr[-1]
# Решил задачу за 12 минут 30 секунд
