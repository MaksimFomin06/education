3) 
def bin_search(n, arr, target):
    left = 0
    right = n - 1
    ans = "NO"

    while left <= right:
        mid = (left + right) // 2

        if arr[mid] == target:
            ans = "YES"
            break
        elif arr[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    
    return ans


n = int(input())
arr = list(map(int, input().split()))
q = int(input())

for i in range(q):
    target = int(input())

    print(bin_search(n, arr, target))
